outube.com/results?search_query=Brandy+Best+Friend", "search": true}, {"label": "soundcloud", "url": "https://soundcloud.com/search?q=Brandy+Best+Friend", "search": true}, {"label": "spotify", "url": "https://open.spotify.com/search/Brandy+Best+Friend", "search": true}, {"label": "apple", "url": "https://music.apple.com/au/song/321974627", "search": false}, {"label": "deezer", "url": "https://www.deezer.com/search/Brandy+Best+Friend", "search": true}, {"label": "discogs", "url": "https://www.discogs.com/search/?q=Brandy+Best+Friend&type=all", "search": true}], "notes": ["1994 Rhino Atlantic"]}, {"t": 3060, "time": "00:51:00", "artist": "702", "title": "Blah, Blah, Blah, Blah", "conf": "high", "links": [{"label": "bandcamp", "url": "https://bandcamp.com/search?q=702+Blah%2C+Blah%2C+Blah%2C+Blah", "search": true}, {"label": "youtube", "url": "https://www.youtube.com/results?search_query=702+Blah%2C+Blah%2C+Blah%2C+Blah", "search": true}, {"label": "soundcloud", "url": "https://soundcloud.com/search?q=702+Blah%2C+Blah%2C+Blah%2C+Blah", "search": true}, {"label": "spotify", "url": "https://open.spotify.com/search/702+Blah%2C+Blah%2C+Blah%2C+Blah", "search": true}, {"label": "apple", "url": "https://music.apple.com/au/song/1443388682", "search": false}, {"label": "deezer", "url": "https://www.deezer.com/search/702+Blah%2C+Blah%2C+Blah%2C+Blah", "search": true}, {"label": "discogs", "url": "https://www.discogs.com/search/?q=702+Blah%2C+Blah%2C+Blah%2C+Blah&type=all", "search": true}], "notes": ["2003 Motown"]}], "counts": {"high": 5, "mid": 3, "low": 2}, "transcripts": [{"start": "00:14:43", "end": "00:15:30", "text": "Rhythmic Resistance, FBi Radio, and this is all happening as well on stolen land, on Gadigal land, and it's important that I recognise where this is happening and acknowledge the oppression that's also happening to Aboriginal and Indigenous First Nations people as well. rhythmic resistance is the space that allows voices that aren't meant to be heard and meant to as in we aren't allowed to use our voices but this music you will hear the music you will hear the people and you will hear the voices and that is that today this is 702"}, {"start": "00:29:26", "end": "00:32:29", "text": "I Still Love You. This is 702. We're listening to their 2003 album Star for the Stargirls. I think the name came from their area code, their postcode from Las Vegas. But yeah, this is an American R&B group. And this is Rhythmic Resistance. music that carries memory and culture and music that lets you feel good but also if you don't feel good as well you don't have to feel good it's not always about music and resistance itself it doesn't have to be just sadness resistance can also be happiness and joy and allowing your identity to be seen and shown and this is a space that honors that and honors the roots and histories and we're not here to rewrite or erase our identities we're not changing it up we're telling it from our voices and our mouths that's what you're gonna listen to and this is rhythmic resistance um but yeah text in let me know how you're feeling today i really want to know how'd you wake up how's your day been how have you started your day how is life treating you you know how are you preparing for this full moon that's coming up the harvest full moon how are you yeah how are you taking care of yourself um yeah text in the text line is 0435123945 I want to know how you guys have been and where you're listening from if you're listening from a car if you're listening from your phone in your bedroom if you're at a park I'm just really curious I want to know what's what's happening with niggas man like what's what's popping like what are you guys what are guys doing right now and how is music allowing you to channel your feelings and your emotions and how are you finding safety in music as well but yeah let's have a little text line this is music i don't know what i was gonna say but yeah just text me man i sound crazy right now like yo just text me just text me please answer but like just text him i want to i want to know how you are um yeah 94.5 fbi radio american r&b 702"}, {"start": "00:44:35", "end": "00:44:51", "text": "A special dedication and special song request from a friend, dear friend with me right now, Annabelle. This is I Want to Lay With You by Shira Small."}, {"start": "00:45:21", "end": "00:45:38", "text": "Friends, anyone that you're thinking of right now, anyone that comes to mind that you want to lay with, this is for them. This is dedicated as well, or someone that comes to mind, Sarah, I'm thinking of you and"}, {"start": "00:59:12", "end": "00:59:30", "text": "Sydney, 702, Las Vegas, R&B Music, playing on Rhythmic Resistance, FBi Radio. We sadly do gotta go because we got like one minute left, but we'll play one more time."}], "fbi_json": [{"timestamp": {"enabled": true, "formatted": "00:00:00"}, "track": {"title": "Purception (Copyright Free)", "artists": [{"name": "MONKEY PUNCH"}]}, "isPremiere": false, "_confidence": "low"}, {"timestamp": {"enabled": true, "formatted": "00:02:00"}, "track": {"title": "Day & Night (Remix) [feat. Jadakiss]", "artists": [{"name": "ISYSS"}]}, "isPremiere": false, "_confidence": "low"}, {"timestamp": {"enabled": true, "formatted": "00:05:05"}, "track": {"title": "Star (feat. Clipse)", "artists": [{"name": "702"}]}, "isPremiere": false, "_confidence": "mid"}, {"timestamp": {"enabled": true, "formatted": "00:12:35"}, "track": {"title": "No Doubt", "artists": [{"name": "702"}]}, "isPremiere": false, "_confidence": "high"}, {"timestamp": {"enabled": true, "formatted": "00:16:56"}, "track": {"title": "Feelings", "artists": [{"name": "702"}]}, "isPremiere": false, "_confidence": "mid"}, {"timestamp": {"enabled": true, "formatted": "00:24:43"}, "track": {"title": "I Still Love You", "artists": [{"name": "702"}]}, "isPremiere": false, "_confidence": "high"}, {"timestamp": {"enabled": true, "formatted": "00:36:33"}, "track": {"title": "Places", "