ery+Age", "search": true}, {"label": "youtube", "url": "https://www.youtube.com/results?search_query=Le+Ren+Every+Age", "search": true}, {"label": "soundcloud", "url": "https://soundcloud.com/search?q=Le+Ren+Every+Age", "search": true}, {"label": "spotify", "url": "https://open.spotify.com/search/Le+Ren+Every+Age", "search": true}, {"label": "apple", "url": "https://music.apple.com/au/song/6766149652", "search": false}, {"label": "deezer", "url": "https://www.deezer.com/search/Le+Ren+Every+Age", "search": true}, {"label": "discogs", "url": "https://www.discogs.com/search/?q=Le+Ren+Every+Age&type=all", "search": true}], "notes": ["2026 Royal Mountain Records"]}, {"t": 5167, "time": "01:26:07", "artist": "Chateau", "title": "Man of the Country", "conf": "mid", "links": [{"label": "bandcamp", "url": "https://chateaumusic.bandcamp.com/album/sometimes-we-wander", "search": false}, {"label": "youtube", "url": "https://www.youtube.com/watch?v=jZy9bMo5odg", "search": false}, {"label": "soundcloud", "url": "https://soundcloud.com/search?q=Chateau+Man+of+the+Country", "search": true}, {"label": "spotify", "url": "https://open.spotify.com/search/Chateau+Man+of+the+Country", "search": true}, {"label": "apple", "url": "https://music.apple.com/au/search?term=Chateau+Man+of+the+Country", "search": true}, {"label": "deezer", "url": "https://www.deezer.com/search/Chateau+Man+of+the+Country", "search": true}, {"label": "discogs", "url": "https://www.discogs.com/search/?q=Chateau+Man+of+the+Country&type=all", "search": true}], "notes": ["“just there we had Chateau with Man of the Country”", "Track on Sydney band Chateau's EP 'Sometimes We Wander'."]}, {"t": 5432, "time": "01:30:32", "artist": "@", "title": "Autosmile", "conf": "high", "links": [{"label": "bandcamp", "url": "https://bandcamp.com/search?q=%40+Autosmile", "search": true}, {"label": "youtube", "url": "https://www.youtube.com/results?search_query=%40+Autosmile", "search": true}, {"label": "soundcloud", "url": "https://soun